[Unit]
Description=ATAK KLV Camera Server
After=network.target lcam.service

[Service]
ExecStart=/usr/bin/python3 /home/user/chimera-deploy/local/klv_rtsp_server.py
WorkingDirectory=/home/user/chimera-deploy/local
User=user
Group=user
Restart=always
RestartSec=5
Environment="PYTHONUNBUFFERED=1"

[Install]
WantedBy=multi-user.target
